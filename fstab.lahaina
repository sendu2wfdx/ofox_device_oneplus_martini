# fstab for OnePlus 9RT (martini) - A/B device with dynamic partitions
# Based on stock fstab from OxygenOS

# system (dynamic, ext4)
/dev/block/mapper/system /system ext4 ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey,avb=vbmeta
/dev/block/mapper/system_ext /system_ext ext4 ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
/dev/block/mapper/product /product ext4 ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
/dev/block/mapper/vendor /vendor ext4 ro wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
/dev/block/mapper/odm /odm ext4 ro wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
/dev/block/mapper/vendor_dlkm /vendor_dlkm ext4 ro wait,slotselect,logical,first_stage_mount

# boot / vendor_boot
/dev/block/by-name/boot /boot emmc defaults recoveryonly,slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults recoveryonly,slotselect

# userdata (f2fs with FBE)
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt latemount,wait,check,fileencryption=ice,wrappedkey,keydirectory=/metadata/vold/metadata_encryption,quota,formattable,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc

# metadata
/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev wait,formattable,first_stage_mount,check

# misc
/dev/block/by-name/misc /misc emmc defaults defaults

# UFS
/devices/platform/soc/1d84000.ufshc /dev/block/bootdevice auto auto defaults voldmanaged=sda:auto
